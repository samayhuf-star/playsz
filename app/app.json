{
  "expo": {
    "name": "Dimmer",
    "slug": "openplay",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "playszvault",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.samayvashsht.playsz",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Dimmer reads your video library so you can play videos, and moves videos you choose into your private vault. After you confirm, the originals are deleted from Photos.",
        "NSPhotoLibraryAddUsageDescription": "Dimmer can save exported videos to your library when you choose to export a file.",
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDisplayName": "Dimmer",
        "CFBundleName": "Dimmer",
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Dimmer uses Face ID to lock and unlock your private vault.",
        "NSCameraUsageDescription": "Dimmer uses the camera so you can capture photos and videos straight into your private vault. Nothing is saved to your Photos library.",
        "NSMicrophoneUsageDescription": "Dimmer uses the microphone to record sound with videos you capture into your private vault."
      },
      "appleTeamId": "PGLT2QZX88",
      "buildNumber": "7",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.allinone.videoplayer",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Dimmer uses Face ID to lock and unlock your private vault."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Dimmer reads your video library so you can play videos, and moves videos you choose into your private vault. After you confirm, the originals are deleted from Photos.",
          "savePhotosPermission": "Dimmer can save exported videos to your library when you choose to export a file.",
          "granularPermissions": [
            "video"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-iap",
      [
        "expo-camera",
        {
          "cameraPermission": "Dimmer uses the camera so you can capture photos and videos straight into your private vault. Nothing is saved to your Photos library.",
          "microphonePermission": "Dimmer uses the microphone to record sound with videos you capture into your private vault.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/with-launcher-label.js",
      "expo-sharing",
      "expo-document-picker",
      "./plugins/with-remove-system-alert-window.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "102274b2-1330-4a79-b23a-b6ddfbdd87c4"
      }
    },
    "owner": "krosz"
  }
}