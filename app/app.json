{
  "expo": {
    "name": "OpenPlay",
    "slug": "openplay",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "openplay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.allinone.videoplayer",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "OpenPlay needs access to your video library so you can play videos stored on this device.",
        "NSPhotoLibraryAddUsageDescription": "OpenPlay can save exported videos to your library when you choose to export a file.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.allinone.videoplayer",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "OpenPlay needs access to your video library so you can play videos stored on this device.",
          "savePhotosPermission": "OpenPlay can save exported videos to your library when you choose to export a file.",
          "granularPermissions": [
            "video"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
