{
  "expo": {
    "name": "Playsz - All In One Player",
    "slug": "openplay",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "openplay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.samayvashsht.playsz",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Playsz needs access to your video library so you can play videos stored on this device.",
        "NSPhotoLibraryAddUsageDescription": "Playsz can save exported videos to your library when you choose to export a file.",
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDisplayName": "Playsz",
        "CFBundleName": "Playsz"
      },
      "appleTeamId": "PGLT2QZX88",
      "buildNumber": "4"
    },
    "android": {
      "package": "com.allinone.videoplayer",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Playsz uses Face ID to lock and unlock your private folder."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Playsz needs access to your video library so you can play videos stored on this device.",
          "savePhotosPermission": "Playsz can save exported videos to your library when you choose to export a file.",
          "granularPermissions": [
            "video"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-iap",
      "./plugins/with-launcher-label.js",
      "expo-sharing",
      "expo-document-picker",
      "./plugins/with-remove-system-alert-window.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "102274b2-1330-4a79-b23a-b6ddfbdd87c4"
      }
    },
    "owner": "krosz"
  }
}
